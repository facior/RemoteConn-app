{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemoteConn",
  "version": "0.2.0",
  "identifier": "com.remoteconn.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RemoteConn",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFNUUyNjY5MDlDQUZDRjQKUldUMC9Nb0phU1plN3FhZEtxZTl2Uy9VUkJsN1pBRWxtNEdDc3QzK1FheXBTSlJJZHk5ejh1VjEK",
      "endpoints": ["https://github.com/facior/RemoteConn-app/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
